PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hospital_management?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5000
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters-long
APP_BASE_URL=http://localhost:5000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Optional fallback when the network DNS blocks MongoDB SRV lookups:
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
